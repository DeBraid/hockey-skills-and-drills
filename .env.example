# Copy to .env.local for a local server. On Vercel, add these in
# Project → Settings → Environment Variables. See SETUP-VERCEL.md.

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend → API keys. Sending address on the verified derekbraid.com domain.
AUTH_RESEND_KEY=
EMAIL_FROM=

# Added automatically by the Vercel Neon integration.
DATABASE_URL=

# Leave BASE_PATH unset. The site is the whole host at hockey.derekbraid.com.
# BASE_PATH=
CANONICAL_HOST=hockey.derekbraid.com

# Local tests only. Do not set this on Vercel.
# EMAIL_DELIVERY=console
