{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*/",
      "destination": "/api/auth/handler?__auth=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/handler?__auth=:path*"
    },
    {
      "source": "/api/plans/:id/",
      "destination": "/api/plans/item?__plan=:id"
    },
    {
      "source": "/api/plans/:id",
      "destination": "/api/plans/item?__plan=:id"
    },
    {
      "source": "/api/plans/",
      "destination": "/api/plans"
    },
    {
      "source": "/api/health/",
      "destination": "/api/health"
    },
    {
      "source": "/api/account/",
      "destination": "/api/account"
    },
    {
      "source": "/hockey-skills-and-drills/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/hockey-skills-and-drills",
      "destination": "/index.html"
    },
    {
      "source": "/hockey-skills-and-drills/",
      "destination": "/index.html"
    },
    {
      "source": "/hockey-skills-and-drills/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
