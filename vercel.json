{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*/",
      "destination": "/api/auth/handler?__auth=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/handler?__auth=:path*"
    },
    {
      "source": "/api/plans/:id/",
      "destination": "/api/plans/item?__plan=:id"
    },
    {
      "source": "/api/plans/:id",
      "destination": "/api/plans/item?__plan=:id"
    },
    {
      "source": "/api/plans/",
      "destination": "/api/plans"
    },
    {
      "source": "/api/health/",
      "destination": "/api/health"
    },
    {
      "source": "/api/account/",
      "destination": "/api/account"
    },
    {
      "source": "/api/event/",
      "destination": "/api/event"
    },
    {
      "source": "/lineups",
      "destination": "/api/lineups?__lu=teams"
    },
    {
      "source": "/lineups/",
      "destination": "/api/lineups?__lu=teams"
    },
    {
      "source": "/lineups/rosters",
      "destination": "/api/lineups?__lu=rosters"
    },
    {
      "source": "/lineups/rosters/",
      "destination": "/api/lineups?__lu=rosters"
    },
    {
      "source": "/lineups/team/:team",
      "destination": "/api/lineups?__lu=list&__team=:team"
    },
    {
      "source": "/lineups/team/:team/",
      "destination": "/api/lineups?__lu=list&__team=:team"
    },
    {
      "source": "/lineups/team/:team/roster",
      "destination": "/api/lineups?__lu=roster&__team=:team"
    },
    {
      "source": "/lineups/team/:team/roster/",
      "destination": "/api/lineups?__lu=roster&__team=:team"
    },
    {
      "source": "/lineups/team/:team/:id",
      "destination": "/api/lineups?__lu=edit&__team=:team&__id=:id"
    },
    {
      "source": "/lineups/team/:team/:id/",
      "destination": "/api/lineups?__lu=edit&__team=:team&__id=:id"
    },
    {
      "source": "/api/lineups/team/:team/roster/:id",
      "destination": "/api/lineups?__lu=api-player&__team=:team&__id=:id"
    },
    {
      "source": "/api/lineups/team/:team/roster/:id/",
      "destination": "/api/lineups?__lu=api-player&__team=:team&__id=:id"
    },
    {
      "source": "/api/lineups/team/:team/roster",
      "destination": "/api/lineups?__lu=api-roster&__team=:team"
    },
    {
      "source": "/api/lineups/team/:team/roster/",
      "destination": "/api/lineups?__lu=api-roster&__team=:team"
    },
    {
      "source": "/api/lineups/team/:team",
      "destination": "/api/lineups?__lu=api-collection&__team=:team"
    },
    {
      "source": "/api/lineups/team/:team/",
      "destination": "/api/lineups?__lu=api-collection&__team=:team"
    },
    {
      "source": "/lineups/roster",
      "destination": "/api/lineups?__lu=roster"
    },
    {
      "source": "/lineups/roster/",
      "destination": "/api/lineups?__lu=roster"
    },
    {
      "source": "/lineups/v/:token",
      "destination": "/api/lineups?__lu=view&__t=:token"
    },
    {
      "source": "/lineups/v/:token/",
      "destination": "/api/lineups?__lu=view&__t=:token"
    },
    {
      "source": "/lineups/:id",
      "destination": "/api/lineups?__lu=edit&__id=:id"
    },
    {
      "source": "/lineups/:id/",
      "destination": "/api/lineups?__lu=edit&__id=:id"
    },
    {
      "source": "/api/lineups/v/:token",
      "destination": "/api/lineups?__lu=api-view&__t=:token"
    },
    {
      "source": "/api/lineups/v/:token/",
      "destination": "/api/lineups?__lu=api-view&__t=:token"
    },
    {
      "source": "/api/lineups/roster/:id",
      "destination": "/api/lineups?__lu=api-player&__id=:id"
    },
    {
      "source": "/api/lineups/roster/:id/",
      "destination": "/api/lineups?__lu=api-player&__id=:id"
    },
    {
      "source": "/api/lineups/roster",
      "destination": "/api/lineups?__lu=api-roster"
    },
    {
      "source": "/api/lineups/roster/",
      "destination": "/api/lineups?__lu=api-roster"
    },
    {
      "source": "/api/lineups/:id/share",
      "destination": "/api/lineups?__lu=api-share&__id=:id"
    },
    {
      "source": "/api/lineups/:id/share/",
      "destination": "/api/lineups?__lu=api-share&__id=:id"
    },
    {
      "source": "/api/lineups/:id",
      "destination": "/api/lineups?__lu=api-item&__id=:id"
    },
    {
      "source": "/api/lineups/:id/",
      "destination": "/api/lineups?__lu=api-item&__id=:id"
    },
    {
      "source": "/api/lineups/",
      "destination": "/api/lineups?__lu=api-collection"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin"
    },
    {
      "source": "/hockey-skills-and-drills/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/hockey-skills-and-drills",
      "destination": "/index.html"
    },
    {
      "source": "/hockey-skills-and-drills/",
      "destination": "/index.html"
    },
    {
      "source": "/hockey-skills-and-drills/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
